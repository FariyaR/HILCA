# LLM provider: mock | anthropic | openai
# 'mock' runs fully offline with no key and no spend (default).
LLM_PROVIDER=mock

# Used only when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5   # set to your current model string

# Used only when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# SQLite file location
DB_PATH=hilca.db

# --- Tiered model routing + sampling (master file v2) ------------------------
# HILCA_MODEL_LOW=             # summaries/log entries (default: haiku / gpt-4o-mini)
# HILCA_MODEL_MID=             # agents + CCU round work (default: base model)
# HILCA_MODEL_HIGH=            # final synthesis + deliverable (default: base model)
# HILCA_TEMPERATURE=0          # every call runs at temp 0 (original behavior);
#                              # set 'none' for the provider default
# HILCA_PROMPT_CACHE=1         # Anthropic prompt caching of static heavy blocks

# --- Dialectic flow (all optional; defaults shown) ---------------------------
# HILCA_MAIN_ROUNDS=3          # rounds 1..N of the main loop (round 1 included)
# HILCA_FINAL_ROUNDS=3         # the final conclusion loop (original ran 3)
# HILCA_TOKEN_BUDGET=2000000   # cumulative prompt+completion cap per run
# HILCA_CCU_MAX_TOKENS=8000    # CCU replies (cast briefing, wrap-ups, P8, P10) — keep
                               # generous: a cast truncated mid-JSON aborts round 1
# HILCA_AGENT_MAX_TOKENS=2500
# HILCA_SUMMARY_MAX_TOKENS=600
# HILCA_REFERENCE_PATH=reference/HILCA_master_reference_v2.txt
# HILCA_MAX_REFERENCE_CHARS=60000
# HILCA_MAX_SOURCE_CHARS=20000
# HILCA_MAX_CONTEXT_CHARS=120000
# HILCA_DOCS_ROOT=runs         # per-run .md docs + run_log.csv land here
# HILCA_MAX_FETCH_BYTES=8388608  # per-URL download cap (bytes)
# HILCA_ALLOW_MOCK=1           # ONLY for offline demos: lets the web stream run on the mock provider

# --- Convergence machinery (Critique-Refine-Vote, master file batch 2) -------
# HILCA_CONVERGENCE_EXIT=1     # allow the main loop to exit early on convergence
# HILCA_CONVERGENCE_THRESHOLD=0.85  # average agent vote needed to exit
# HILCA_STANCE_SIMILARITY=0.90 # per-agent stance similarity that counts as "unchanged"
# HILCA_STANCE_STABLE_ROUNDS=2 # consecutive stable rounds that end the loop
# HILCA_TARGETED_RETRIEVAL=1   # stateless mode: top-k chunks per turn instead of full context
# HILCA_RUNNING_SUMMARY_CAP=8000  # char cap on the sliding round summary

# --- Hybrid retrieval: the vector/embedding half ------------------------------
# The keyword half (BM25 + exact phrase) always runs; the vector half embeds
# the context chunks and fuses cosine similarity into the ranking. Embedding
# failures never fail a run — retrieval degrades to BM25-only, logged.
# HILCA_EMBEDDINGS=auto        # auto | openai | hash | off. auto = OpenAI
#                              # embeddings when OPENAI_API_KEY is set (and not
#                              # mock mode), else the offline hash embedder
# HILCA_EMBED_MODEL=text-embedding-3-small
# HILCA_HYBRID_ALPHA=0.5       # weight of the vector half, 0..1 (0 = pure BM25)

# --- Context compaction (Claude-style /compact) -------------------------------
# The composer's ring shows how much of the working context window is in use;
# clicking it compacts every participant's conversation into a digest and the
# dialectic continues from there. Crossing the threshold compacts automatically.
# HILCA_CONTEXT_WINDOW=30000   # working context budget in tokens the ring measures
#                              # against (match your TPM limit / model context)
# HILCA_COMPACT_AT=0.70        # auto-compact when the next request would cross this
#                              # fraction of the window (0 disables auto-compaction)
# HILCA_COMPACT_MAX_TOKENS=700 # size of each participant's compacted digest

# --- Rate limits (429 handling) ----------------------------------------------
# HILCA_TPM_LIMIT=0            # your org's tokens-per-minute limit for the model;
#                              # set it (e.g. 30000 for an OpenAI tier-1 gpt-4o org)
#                              # and HILCA paces calls to stay under it. 0 = off.
# HILCA_LLM_RETRIES=5          # attempts per call when the provider returns 429
# HILCA_LLM_BACKOFF_BASE=2     # first retry wait in seconds (doubles per attempt)
#
# RECIPE for a 30k-TPM org (OpenAI tier 1): a single round-1 prompt must fit the
# per-minute budget, so shrink the injected context AND enable pacing:
#   HILCA_TPM_LIMIT=30000
#   HILCA_MAX_CONTEXT_CHARS=40000
#   HILCA_MAX_REFERENCE_CHARS=30000
#   HILCA_MAX_SOURCE_CHARS=8000
#   HILCA_AGENT_MAX_TOKENS=1500
#   HILCA_CCU_MAX_TOKENS=2500

# --- Phase-2 amendments (Shahab's meeting notes) -----------------------------
# HILCA_THREADED=1             # chat-thread mode: each participant keeps one coherent
#                              # conversation per run (context-aware, saves tokens).
#                              # Set 0 to restore the stateless single-turn behavior.
# HILCA_THREAD_KEEP=8          # exchanges kept per thread besides the round-1 grounding
#                              # (loop engineering for long, high-round-cap runs)

# Emailing the final deliverable (optional; download always works without it)
# SMTP_HOST=                   # unset = emailing disabled
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=                   # defaults to SMTP_USER
# SMTP_STARTTLS=1
